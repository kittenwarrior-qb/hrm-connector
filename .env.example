# Copy thành .env (KHÔNG commit .env / accounts.json / data/)

PORT=3000
# IP lắng nghe: để trống = mọi địa chỉ; đặt IP nội bộ của VPS để chỉ mạng trong gọi được
HOST=
# Khoá bảo vệ API, gửi qua header: x-api-key: <API_KEY>
API_KEY=change-me-to-a-long-random-string

# Danh sách account các nguồn (xem accounts.example.json)
ACCOUNTS_FILE=accounts.json
# Thư mục lưu cookie phiên đăng nhập của từng account
DATA_DIR=data

# Lịch sync tự động (cron, giờ máy chủ): mặc định 15 phút/lần từ 7h-21h. Để trống để tắt.
SYNC_CRON=*/15 7-21 * * *
SYNC_TZ=Asia/Ho_Chi_Minh
SYNC_ON_START=true
# Tin hết hạn quá N ngày thì thôi đồng bộ (đặt bằng satori_recruitment_jobboard.retention_days bên Odoo)
SYNC_WINDOW_DAYS=90

# Odoo — user TÍCH HỢP có nhóm "Tuyển dụng: Đồng bộ tin & hồ sơ nguồn ngoài",
# đăng nhập bằng API key (Preferences > Account Security > New API Key)
ODOO_URL=https://odoo.example.com
ODOO_DB=your_db
ODOO_USERNAME=hrm-connector
ODOO_API_KEY=
